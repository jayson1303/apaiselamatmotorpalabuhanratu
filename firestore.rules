rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Siapa saja boleh membaca (READ) data untuk landing page publik
    // Hanya user yang terotentikasi (Admin login) yang boleh menulis (WRITE: create, update, delete)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
