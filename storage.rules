rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Siapa saja boleh melihat/mengunduh (READ) foto produk, banner, dan testimoni
    // Hanya user yang terotentikasi (Admin login) yang boleh mengunggah/mengubah/menghapus (WRITE)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
